# Normalize line endings for text files
* text=auto

# ---------------------------------------------------------------
# Unity YAML files: merge with Unity's Smart Merge tool
# (each dev runs the one-time setup in README.md)
# ---------------------------------------------------------------
*.unity      merge=unityyamlmerge eol=lf linguist-generated
*.prefab     merge=unityyamlmerge eol=lf linguist-generated
*.asset      merge=unityyamlmerge eol=lf linguist-generated
*.mat        merge=unityyamlmerge eol=lf linguist-generated
*.anim       merge=unityyamlmerge eol=lf linguist-generated
*.controller merge=unityyamlmerge eol=lf linguist-generated
*.overrideController merge=unityyamlmerge eol=lf linguist-generated
*.physicMaterial merge=unityyamlmerge eol=lf linguist-generated
*.physicsMaterial2D merge=unityyamlmerge eol=lf linguist-generated
*.playable   merge=unityyamlmerge eol=lf linguist-generated
*.mask       merge=unityyamlmerge eol=lf linguist-generated
*.brush      merge=unityyamlmerge eol=lf linguist-generated
*.flare      merge=unityyamlmerge eol=lf linguist-generated
*.fontsettings merge=unityyamlmerge eol=lf linguist-generated
*.guiskin    merge=unityyamlmerge eol=lf linguist-generated
*.giparams   merge=unityyamlmerge eol=lf linguist-generated
*.renderTexture merge=unityyamlmerge eol=lf linguist-generated
*.spriteatlas merge=unityyamlmerge eol=lf linguist-generated
*.terrainlayer merge=unityyamlmerge eol=lf linguist-generated
*.mixer      merge=unityyamlmerge eol=lf linguist-generated
*.shadervariants merge=unityyamlmerge eol=lf linguist-generated
*.preset     merge=unityyamlmerge eol=lf linguist-generated
*.asmdef     text eol=lf
*.meta       merge=unityyamlmerge eol=lf

# Code
*.cs         text diff=csharp
*.shader     text
*.hlsl       text
*.json       text
*.md         text

# ---------------------------------------------------------------
# Large binary files: stored with Git LFS
# ---------------------------------------------------------------
# 3D models
*.blend  filter=lfs diff=lfs merge=lfs -text
